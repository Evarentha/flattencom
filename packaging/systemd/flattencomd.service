[Unit]
Description=flattencom serial workbench daemon
After=default.target

[Service]
Type=simple
ExecStart=%h/.local/bin/flattencomd --foreground
Restart=on-failure
RestartSec=2
Environment=RUST_LOG=info

[Install]
WantedBy=default.target
