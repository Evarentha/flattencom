[Desktop Entry]
Type=Application
Name=flattencom
GenericName=Serial Workbench
Comment=Serial debugging with GUI, CLI and MCP
Exec=flattencom-gui
Icon=flattencom
Terminal=false
Categories=Development;Utility;
StartupWMClass=flattencom-gui
