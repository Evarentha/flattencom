[
 {"id":"kernel-panic","category":"kernel/crash","severity":"fatal","pattern":"\\bKernel panic\\b|\\bnot syncing\\b|\\bFatal exception\\b|\\bdouble fault\\b","color":"#ff667a"},
 {"id":"oops-bug","category":"kernel/crash","severity":"fatal","pattern":"\\bOops:|\\bBUG:|Unable to handle kernel|\\bNULL pointer dereference\\b|\\bKASAN:|\\bUBSAN:","color":"#ff667a"},
 {"id":"watchdog-lockup","category":"watchdog","severity":"fatal","pattern":"\\b(?:soft|hard) lockup\\b|watchdog.*(?:timeout|timed out|reset|lockup)|\\brcu[^\\r\\n]*stall|blocked for more than \\d+ seconds","color":"#ff667a"},
 {"id":"oom","category":"memory","severity":"fatal","pattern":"Out of memory:|\\boom-kill:|invoked oom-killer|Killed process \\d+","color":"#ff667a"},
 {"id":"boot-rootfs","category":"boot/rootfs","severity":"fatal","pattern":"VFS: Unable to mount root fs|No working init found|Failed to execute /.*init|Cannot open root device|No init found","color":"#ff667a"},
 {"id":"stacktrace","category":"kernel/trace","severity":"error","pattern":"Call [Tt]race:|Backtrace:|\\bRIP:|\\bPC is at\\b|\\bLR is at\\b|---\\[ end trace|Internal error:","color":"#ed7985"},
 {"id":"segfault","category":"process/crash","severity":"error","pattern":"\\bsegfault at\\b|\\bSegmentation fault\\b|\\bcore dumped\\b|\\bassertion .*failed\\b|\\bassert failed\\b","color":"#ed7985"},
 {"id":"storage-io","category":"storage","severity":"error","pattern":"\\bI/O error\\b|\\bBuffer I/O\\b|blk_update_request:|end_request: I/O|critical medium error|uncorrectable (?:ECC|error)","color":"#ed7985"},
 {"id":"filesystem","category":"filesystem","severity":"error","pattern":"EXT4-fs error|EXT3-fs error|BTRFS error|XFS.*(?:corrupt|error|shutdown)|UBIFS error|JFFS2.*(?:CRC|error)|FAT-fs.*(?:error|corrupt)","color":"#ed7985"},
 {"id":"mmc","category":"storage/mmc","severity":"error","pattern":"mmc.*(?:error -\\d+|timeout|timed out|CRC error)|sdhci.*(?:error|timeout)|nand.*(?:uncorrectable|bad block table.*failed)","color":"#ed7985"},
 {"id":"usb","category":"usb","severity":"error","pattern":"device descriptor read.*error|unable to enumerate USB|USB disconnect|xhci.*(?:ERROR|not responding)|usb.*(?:error -\\d+|over-current)","color":"#ed7985"},
 {"id":"firmware","category":"firmware","severity":"error","pattern":"Direct firmware load .* failed|firmware.*(?:failed to load|not found|crash)|request_firmware.*failed|remoteproc.*crash","color":"#ed7985"},
 {"id":"driver-probe","category":"driver","severity":"error","pattern":"probe .* failed with error|failed to (?:request|enable|initialize|initialise|register|allocate|map)|could not (?:request|enable|initialize|register|allocate)","color":"#ed7985"},
 {"id":"bus","category":"bus/i2c/spi","severity":"error","pattern":"(?:i2c|spi|regmap).*(?:timeout|timed out|transfer failed|read failed|write failed|error -)|arbitration lost|bus recovery failed","color":"#ed7985"},
 {"id":"network","category":"network","severity":"error","pattern":"NETDEV WATCHDOG|transmit queue .*timed out|DHCP.*(?:failed|timeout)|link.*(?:is down|lost)|No route to host|Network is unreachable|Connection refused","color":"#ed7985"},
 {"id":"service-failed","category":"userspace/systemd","severity":"error","pattern":"\\[FAILED\\]|Failed to start |Failed to mount |Main process exited.*(?:FAILURE|status=[1-9])|dependency failed for","color":"#ed7985"},
 {"id":"security","category":"security","severity":"error","pattern":"avc: *denied|apparmor=.*DENIED|Permission denied|authentication failure|verification failed|signature.*(?:invalid|failed)","color":"#ed7985"},
 {"id":"thermal","category":"power/thermal","severity":"error","pattern":"critical temperature|thermal shutdown|under.?voltage detected|brownout detector|power supply.*failed","color":"#ed7985"},
 {"id":"protocol","category":"protocol","severity":"error","pattern":"CRC (?:error|failed|mismatch)|checksum (?:error|failed|mismatch)|framing error|parity error|overrun error|buffer overflow","color":"#ed7985"},
 {"id":"explicit-error","category":"general","severity":"error","pattern":"(?:^|[\\s\\]])(?:ERROR|FATAL|ERR)(?:[:\\s\\[]|$)|\\[E\\]|\\berror[:=]\\s*-?[1-9]\\d*","color":"#ed7985"},
 {"id":"warning","category":"general","severity":"warning","pattern":"\\bWARNING:|\\bWARN(?:ING)?\\s*[:\\[]|\\[W\\]|\\bdeprecated\\b|\\btainted\\b","color":"#e5b45a"},
 {"id":"timeout","category":"timing","severity":"warning","pattern":"\\btimed out\\b|\\btimeout\\b(?!\\s*[=:]\\s*0\\b)|retrying|retry limit|retries exhausted","color":"#e5b45a"},
 {"id":"resources","category":"resources","severity":"warning","pattern":"No space left on device|read-only file system|allocation failure|page allocation failure|voltage.*out of range","color":"#e5b45a"},
 {"id":"boot-linux","category":"boot/linux","severity":"info","pattern":"(?:^|\\]\\s*)Linux version \\d|Booting Linux on physical CPU","color":"#53c999"},
 {"id":"boot-loader","category":"boot/loader","severity":"info","pattern":"(?:^|\\]\\s*)U-Boot(?: SPL)? \\d|ESP-ROM:|rst:0x[0-9a-f]+.*boot:|Zephyr OS|Starting kernel","color":"#53c999"},
 {"id":"ready","category":"boot/ready","severity":"info","pattern":"Reached target .*Multi-User|Welcome to .*Linux|login: *$|system ready|boot completed|Initialization complete","color":"#53c999"}
]
